# ---------------------------------------------------------------------------
# Canonical environment file for the whole monorepo.
# Copy to `.env` and adjust. `pnpm fga:setup` writes FGA_STORE_ID / FGA_MODEL_ID
# back into `.env` automatically.
# ---------------------------------------------------------------------------

# Prisma / PostgreSQL (docker-compose maps container 5432 -> host 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/fgac"

# Better Auth
BETTER_AUTH_SECRET="dev-only-insecure-secret-change-me-0000000000"
BETTER_AUTH_URL="http://localhost:3000"

# OpenFGA
OPENFGA_API_URL="http://localhost:8080"
# Filled in by `pnpm fga:setup`
FGA_STORE_ID=""
FGA_MODEL_ID=""
