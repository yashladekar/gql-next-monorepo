{
  "name": "gql-next-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "pnpm -r --if-present test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down -v",
    "db:generate": "pnpm --filter @workspace/db prisma:generate",
    "db:migrate": "pnpm --filter @workspace/db prisma:migrate",
    "db:push": "pnpm --filter @workspace/db prisma:push",
    "db:seed": "pnpm --filter @workspace/db seed",
    "fga:setup": "pnpm --filter @workspace/authz fga:setup",
    "fga:seed": "pnpm --filter @workspace/authz fga:seed",
    "setup": "pnpm db:generate && pnpm db:push && pnpm db:seed && pnpm fga:setup"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.5",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
